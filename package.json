{
    "name": "inmanta-studio",
    "displayName": "Inmanta Studio",
    "description": "Visual editors for Inmanta: the Lifecycle Studio and the Onboarding Studio",
    "version": "0.1.0",
    "publisher": "Inmanta",
    "icon": "images/inmanta.ico",
    "license": "Apache-2.0",
    "homepage": "https://github.com/inmanta/vscode-inmanta-studio",
    "repository": {
        "type": "git",
        "url": "https://github.com/inmanta/vscode-inmanta-studio"
    },
    "bugs": {
        "url": "https://github.com/inmanta/vscode-inmanta-studio/issues"
    },
    "keywords": [
        "inmanta",
        "lifecycle",
        "onboarding"
    ],
    "engines": {
        "vscode": "^1.97.2"
    },
    "activationEvents": [
        "workspaceContains:**/files/lifecycle*.csv",
        "workspaceContains:**/onboard.yaml"
    ],
    "categories": [
        "Visualization"
    ],
    "extensionPack": [
        "Inmanta.inmanta"
    ],
    "contributes": {
        "configuration": {
            "type": "object",
            "title": "Inmanta Studio",
            "properties": {
                "inmanta.onboarding.python": {
                    "type": "string",
                    "default": "",
                    "description": "The python of the onboarding engine for the Onboarding Studio. Empty: the first .venv found up from the workspace that holds onboard.yaml.",
                    "scope": "resource"
                }
            }
        },
        "commands": [
            {
                "command": "inmanta.openLifecycleStudio",
                "title": "Open in Lifecycle Studio",
                "category": "inmanta",
                "icon": "$(type-hierarchy)"
            },
            {
                "command": "inmanta.openLifecycleCsvAsText",
                "title": "Open Lifecycle CSV as Text",
                "category": "inmanta",
                "icon": "$(go-to-file)"
            },
            {
                "command": "inmanta.openOnboardingStudio",
                "title": "Open in Onboarding Studio",
                "category": "inmanta",
                "icon": "$(checklist)"
            }
        ],
        "customEditors": [
            {
                "viewType": "inmanta.lifecycleStudio",
                "displayName": "Inmanta Lifecycle Studio",
                "selector": [
                    {
                        "filenamePattern": "*.csv"
                    }
                ],
                "priority": "option"
            },
            {
                "viewType": "inmanta.onboardingStudio",
                "displayName": "Inmanta Onboarding Studio",
                "selector": [
                    {
                        "filenamePattern": "onboard.yaml"
                    }
                ],
                "priority": "option"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "when": "inmanta.lifecycleCsvActive && activeCustomEditorId != inmanta.lifecycleStudio",
                    "command": "inmanta.openLifecycleStudio",
                    "group": "navigation"
                },
                {
                    "when": "activeCustomEditorId == inmanta.lifecycleStudio",
                    "command": "inmanta.openLifecycleCsvAsText",
                    "group": "navigation"
                },
                {
                    "when": "resourceFilename == onboard.yaml && activeCustomEditorId != inmanta.onboardingStudio",
                    "command": "inmanta.openOnboardingStudio",
                    "group": "navigation"
                }
            ],
            "explorer/context": [
                {
                    "when": "resourceExtname == .csv",
                    "command": "inmanta.openLifecycleStudio",
                    "group": "navigation"
                },
                {
                    "when": "resourceFilename == onboard.yaml",
                    "command": "inmanta.openOnboardingStudio",
                    "group": "navigation"
                }
            ]
        }
    },
    "main": "./out/extension.js",
    "scripts": {
        "clean": "rimraf out/",
        "vscode:prepublish": "npm run package",
        "compile": "npm run clean && tsc -p ./ && webpack",
        "watch": "webpack --watch",
        "lint": "eslint --max-warnings 0",
        "test:unit": "tsc -p ./ && mocha --ui tdd \"out/test/unit/**/*.test.js\"",
        "package": "npm run clean && webpack --mode production --devtool source-map --config ./webpack.config.js",
        "vsce-package": "vsce package"
    },
    "dependencies": {
        "@fontsource-variable/red-hat-display": "^5.3.0",
        "@fontsource-variable/red-hat-text": "^5.3.0",
        "elkjs": "^0.12.0",
        "react-icons": "^5.7.0",
        "yaml": "^2.9.1"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^22.19.2",
        "@types/vscode": "^1.97.2",
        "@typescript-eslint/eslint-plugin": "^8.72.0",
        "@typescript-eslint/parser": "^8.74.0",
        "@vscode/vsce": "^4.0.0",
        "eslint": "^10.13.0",
        "mocha": "^12.0.3",
        "rimraf": "^6.1.3",
        "ts-loader": "^9.6.2",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "webpack": "^5.113.0",
        "webpack-cli": "^7.2.3"
    }
}

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        ansiColor('xterm')
    }

    triggers {
        cron("H H(2-5) * * *")
        pollSCM '* * * * *'
    }

    stages {
        stage('Tests') {
            steps {
                sh '''
                    npm ci
                    npm run lint
                    npm run test:unit
                    node_modules/.bin/vsce package
                '''
            }
        }
    }

    post {
        success {
            archiveArtifacts artifacts: '*.vsix', allowEmptyArchive: true
        }
    }
}
